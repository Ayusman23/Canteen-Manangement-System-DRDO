# ==============================================================================
# DRDO Canteen Management System - Enterprise Environment Variables Template
# ==============================================================================

# Port configuration (Required by Render Web Service)
PORT=5000

# PostgreSQL Connection String (Automatically provided on Render if linked)
DATABASE_URL=postgres://drdo_admin:password@host:5432/drdo_canteen

# Frontend URL (Used for CORS and email verification links)
FRONTEND_URL=https://your-canteen-app.vercel.app

# Security & JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here
SESSION_SECRET=your_super_secret_session_key_here

# Brevo Email Delivery (300 free emails/day)
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=your_verified_sender@example.com

# Gmail SMTP Fallback
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password

# Razorpay Online Payment Gateway
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Google Gemini AI Mess Assistant
GEMINI_API_KEY=your_gemini_api_key

# Google Defence Single Sign-On (OAuth)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
